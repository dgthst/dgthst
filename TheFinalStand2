local function Run_Combat_InfiniteAmmoResell()
	local currentGun = GetCurrentGun()
	if not currentGun then
		RemoveOldReticle()
	end

	if isReselling then
		return
	end

	local localCharacter = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local humanoid = GetLocalHumanoid()
	if not humanoid then
		return
	end

	local foundTool = localCharacter:FindFirstChildWhichIsA("Tool")
	if not foundTool then
		return
	end

	if foundTool.Name ~= "Pistol" then -- Prevent sell of guns other than pistol (If bargainer perk is not level 4)
		local bargainerPerk = PlayerPerks:FindFirstChild("SellValue")
		if not bargainerPerk then
			return
		end

		if bargainerPerk.PerkLevel.Value < 4 then
			return
		end
	end

	local currentValues = foundTool:FindFirstChild("CurrentValues")
	if not currentValues then
		return
	end

	local clipValue = currentValues:FindFirstChild("Clip")
	if not clipValue then
		return
	end

	if clipValue.Value > 0 then
		return
	end

	if isReselling then
		return
	end
	isReselling = true

	local toolName = foundTool.Name

	local backpack = GetLocalBackpack()
	local connection = nil
	connection = backpack.ChildAdded:Connect(function(boughtTool)
		local boughtName = boughtTool.Name

		task.delay(0.2, function()
			local startTime = os.clock()
			local foundTool = backpack:FindFirstChild(boughtName)

			while not foundTool do
				task.wait()
				foundTool = backpack:FindFirstChild(boughtName)

				local elapsedTime = (os.clock() - startTime)
				if elapsedTime > 1 then
					break
				end
			end

			if not foundTool then
				return
			end

			task.wait()

			humanoid:EquipTool(foundTool)
		end)

		connection:Disconnect()
		connection = nil
	end)

	SellWeaponEvent:FireServer(toolName)
	task.wait(0.2)

	BuyWeaponEvent:FireServer(toolName)
	task.wait(0.2)

	isReselling = false
end

