--- [[[]]] ---

local Section_Extra_Audio = Tab_Extra:Section({
	Text = "Audio",
	Side = "Left"
})

Section_Extra_Audio:Toggle({
	Text = "Barricade Buzz",
	Tooltip = "Remove the buzzing sound from the barricade's upgrades.",
	Callback = function(Value)
		if Value then
			RunService:BindToRenderStep("Game_RemoveBarricadeBuzz", Enum.RenderPriority.Last.Value, function()
				UpdateBarricadeSFX(false)
			end)
		else
			RunService:UnbindFromRenderStep("Game_RemoveBarricadeBuzz")

			UpdateBarricadeSFX(true)
		end
	end
})

local Section_Extra_Upgrades = Tab_Extra:Section({
	Text = "Upgrades",
	Side = "Right"
})

Section_Extra_Upgrades:Button({
	Text = "Night Vision",
	Tooltip = "Unlock visual upgrades for free. (Client-Sided, Does not count toward 'Overkill' challenge)",
	Callback = function(Value)
		UnlockNightVisionVisuals()
	end
})

-- Runtime

UserInputService.InputBegan:Connect(OnInputBegan)
UserInputService.InputEnded:Connect(OnInputEnded)

SetupESP()

RunService:UnbindFromRenderStep("Combat_BulletSpread")
RunService:BindToRenderStep("Combat_BulletSpread", Enum.RenderPriority.Last.Value, function()
	Run_Combat_BulletSpread()
end)
