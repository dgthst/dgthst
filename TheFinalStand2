end

local function ToolNameToBackpackSlot(name)
	local RobloxGui = CoreGui.RobloxGui
	local BackpackFrame = RobloxGui.Backpack
	local HotbarFrame = BackpackFrame.Hotbar

	for _, textLabel in HotbarFrame:GetChildren() do
		if textLabel.ToolName.Text == name then
			return tonumber(textLabel.Number.Text)
		end
	end
end

