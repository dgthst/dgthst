local function GetCurrentTools(excludeEmptyCharge)
	local localCharacter = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local backpack = GetLocalBackpack()

	local function GetToolChildren(...)
		local objects = {...}

		local toolList = {}

		for _, possibleObject in ipairs(objects) do
			for _, child in possibleObject:GetChildren() do
				if not child:IsA("Tool") then
					continue
				end

				local function HasChargeRemaining()
					local chargeAmount = GetItemCharge(child.Name)
					if not chargeAmount then
						return true
					end

					if chargeAmount <= 0 then
						return false
					end

					return true
				end

				if excludeEmptyCharge and not HasChargeRemaining() then
					continue
				end

				table.insert(toolList, child)
			end
		end

		return toolList
	end

	return GetToolChildren(backpack, localCharacter)
end

