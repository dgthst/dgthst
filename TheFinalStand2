local function SetupESP()
	local oldFolder = CoreGui:FindFirstChild("RuntimeObjects")
	if oldFolder then
		oldFolder:Destroy()
	end

	local folder_main = Instance.new("Folder")
	folder_main.Name = "RuntimeObjects"
	folder_main.Parent = CoreGui

	local folder_zombie = Instance.new("Folder")
	folder_zombie.Name = "Zombie"
	folder_zombie.Parent = folder_main

	local folder_zombie_default = Instance.new("Folder")
	folder_zombie_default.Name = "Default"
	folder_zombie_default.Parent = folder_zombie

	local folder_zombie_special = Instance.new("Folder")
	folder_zombie_special.Name = "Special"
	folder_zombie_special.Parent = folder_zombie

	local folder_player = Instance.new("Folder")
	folder_player.Name = "Player"
	folder_player.Parent = folder_main

	local function CreateHighlight(model, isPlayer)
		if not folder_main then
			return
		end

		if LocalPlayer == isPlayer then
			return
		end

		local highlight = Instance.new("Highlight")
		highlight.FillTransparency = 1

		if isPlayer then
			highlight.OutlineColor = highlightColors.Player
			highlight.Enabled = ESP_Player
			highlight.Parent = folder_player
		else
			highlight.OutlineColor = highlightColors[model.Name] or highlightColors.Undefined
			highlight.Enabled = ESP_Zombie
			if model.Name == "Zombie" then
				highlight.Parent = folder_zombie_default
			else
				highlight.Parent = folder_zombie_special
			end
		end

		highlight.Adornee = model

		model.Destroying:Connect(function()
			if highlight then
				highlight:Destroy()
			end
		end)
	end

	if ZombiesFolder then
		ZombiesFolder.ChildAdded:Connect(function(child)
			CreateHighlight(child)
		end)

		for _, child in ZombiesFolder:GetChildren() do
			CreateHighlight(child)
		end
	end
	
	if workspace then
		workspace.ChildAdded:Connect(function(character)
			local isPlayer = Players:GetPlayerFromCharacter(character)
			if isPlayer then
				CreateHighlight(character, isPlayer)
			end
		end)

		for _, child in workspace:GetChildren() do
			local isPlayer = Players:GetPlayerFromCharacter(child)
			if isPlayer then
				CreateHighlight(child, isPlayer)
			end
		end
	end
end

