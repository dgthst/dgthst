end

local function Run_Farm_TypeB()
	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local localHumanoid = GetLocalHumanoid()
	if not localHumanoid then
		return
	end

	if not PlayerIsAlive() then
		return
	end

	local moving = false

	moving = AutoMovement_Spawn(localCharacter, localRoot, localHumanoid)
	if moving then return end

	moving = AutoMovement_ShopCenter(localCharacter, localRoot, localHumanoid)
	if moving then return end

	moving = AutoMovement_ShopDoor(localCharacter, localRoot, localHumanoid)
	if moving then return end

	moving = AutoMovement_ShopOutside(localCharacter, localRoot, localHumanoid)
	if moving then return end

	if not PlayerIsFirstPerson() then
		SetCameraToFirstPerson()
	end

	if isEquipping then
		return
	end

	local timeSinceLastEquip = (os.clock() - lastAutoEquip)
	if timeSinceLastEquip < 1 then
		return
	end
	
	lastAutoEquip = os.clock()

	local backpack = GetLocalBackpack()
	if not backpack then
		return
	end

	local foundPistol = localCharacter:FindFirstChild("Pistol")
	if not foundPistol then
		foundPistol = backpack:FindFirstChild("Pistol")
		if foundPistol then
			isEquipping = true

			task.delay(0.2, function()
				isEquipping = false
			end)

			localHumanoid:EquipTool(foundPistol)
		else
			BuyWeaponEvent:FireServer("Pistol")
		end

		return
	end
end

