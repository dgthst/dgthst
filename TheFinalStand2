local function OnInputBegan(input, processed)
	if input.UserInputType == settings.aimKeybind then
		aiming = true
	end
end

local function OnInputEnded(input, processed)
	if input.UserInputType == settings.aimKeybind then
		aiming = false
	end
end

local function SetupESP()
    local folder_main = Instance.new("Folder")
    folder_main.Name = "RuntimeObjects"
    folder_main.Parent = CoreGui
    
    local folder_zombie = Instance.new("Folder")
    folder_zombie.Name = "Zombie"
    folder_zombie.Parent = folder_main

    local function OnChildAdded(model)
        local highlight = Instance.new("Highlight")
        highlight.FillTransparency = 1
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.Enabled = ESP_Zombie
        highlight.Adornee = model
        highlight.Parent = folder_zombie
    end
    
    workspace.Zombies.ChildAdded:Connect(OnChildAdded)
end

