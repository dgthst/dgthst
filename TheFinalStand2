local function Run_Combat_AutoHeal()
	local localCharacter = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local localHumanoid = GetLocalHumanoid()
	if not localHumanoid then
		return
	end

	local function FindItemInTable(searchTable, name)
		for _, item in searchTable do
			if item.Name == name then
				return item
			end
		end
	end

	local currentTools = GetCurrentTools(true)
	if not currentTools or #currentTools == 0 then
		return
	end

	local itemChosen = false

	local function EquipItem(item)
		if itemChosen then
			return
		end
		itemChosen = true

		if item.Parent == localCharacter then
			return
		end

		localHumanoid:EquipTool(item)
	end

	local function ActivateItem()
		if isConsuming then
			return
		end
		isConsuming = true

		task.delay(1, function()
			isConsuming = false
		end)

		local foundItem = localCharacter:FindFirstChildWhichIsA("Tool")
		if not foundItem then
			return
		end

		local consumingValue = foundItem:FindFirstChild("Consuming")
		if not consumingValue then
			return
		end

		if consumingValue.Value == true then
			return
		end

		UseConsumableFunction:InvokeServer(foundItem, LocalPlayer)
	end

	local healingItems = {
		["FirstAidKit"] = FindItemInTable(currentTools, "First Aid Kit"),
		["Bandage"] = FindItemInTable(currentTools, "Bandage"),
		["BoosterKit"] = FindItemInTable(currentTools, "Booster Kit"),
	}

	local healthPercentage = (localHumanoid.Health / localHumanoid.MaxHealth) * 100
	if healthPercentage >= 100 then
		return
	end

	local item_FirstAidKit = healingItems.FirstAidKit
	local item_Bandage = healingItems.Bandage
	local item_BoosterKit = healingItems.BoosterKit

	if healthPercentage < 20 then
		if item_BoosterKit then
			EquipItem(item_BoosterKit)
			task.wait()
			ActivateItem()
		end
	end

	if healthPercentage < 40 then
		if item_FirstAidKit then
			EquipItem(item_FirstAidKit)
			task.wait()
			ActivateItem()
		end
	end

	if healthPercentage < 70 then
		if item_Bandage then
			EquipItem(item_Bandage)
			task.wait()
			ActivateItem()
		end
	end
end

local function Run_Combat_AutoShoot()
	local function AttemptClick()
		if Combat_AutoShootRestricted and not lockedOnZombie then
			return
		end

		local currentGun = GetCurrentGun()
		if not currentGun then
			return
		end

		ShortClick1()
	end

	if running_autoShoot then
		return
	end
	running_autoShoot = true

	repeat task.wait()
		AttemptClick()
	until running_autoShoot == false
end

