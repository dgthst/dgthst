local function Run_Aimbot_AimAssist()
	if not isAiming then
		return
	end

	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local head = localCharacter:FindFirstChild("Head")
	if not head then
		return
	end

	local distanceToHead = (CurrentCamera.CFrame.Position - head.Position).Magnitude
	if distanceToHead > 1 then
		return
	end

	local zombieModel, zombieHead = GetClosestZombie(true)
	if not zombieModel then
		return
	end

	local targetPosition = zombieHead.Position

	if zombieHead.Transparency == 1 then
		local rootPart = zombieModel:FindFirstChild("HumanoidRootPart")
		if rootPart then
			targetPosition = rootPart.Position
		end
	end

	CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, targetPosition)
end

local function Run_Farm_Melee()
	frameCounter += 1

	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local humanoid = localCharacter:FindFirstChildWhichIsA("Humanoid")
	if not humanoid then
		return
	end

	if humanoid.Health <= 0 then
		return
	end

	local camDistance = (CurrentCamera.CFrame.Position - localCharacter.Head.Position).Magnitude
	if camDistance > 50 then
		return
	end

	if not localCharacter:GetAttribute("Roblox") then
		CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, SpawnExit.Position)

		local calculation = (SpawnExit.Position - localRoot.Position)
		if calculation.Magnitude > 3 then
			humanoid:Move(calculation.Unit)
			return
		end

		localCharacter:SetAttribute("Roblox", true)

		PlayerTeleportEvent:FireServer(localRoot.Position, 1)
		localCharacter:TranslateBy(Vector3.new(0, 0.2, 8))
	end

	if not localCharacter:GetAttribute("Roblox2") then
		local forwardCFrame = ShopExit.CFrame * CFrame.new(0, 0, -42)
		CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, forwardCFrame.Position)

		local calculation = (forwardCFrame.Position - localRoot.Position)
		if calculation.Magnitude > 3 then
			humanoid:Move(calculation.Unit)
			return
		end

		localCharacter:SetAttribute("Roblox2", true)
	end

	if not localCharacter:GetAttribute("Roblox3") then
		local forwardCFrame = ShopExit.CFrame * CFrame.new(0, 0, -1)
		CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, forwardCFrame.Position)

		local calculation = (forwardCFrame.Position - localRoot.Position)
		if calculation.Magnitude > 3 then
			humanoid:Move(calculation.Unit)
			return
		end

		localCharacter:SetAttribute("Roblox3", true)
	end

	if frameCounter >= 10 then
		frameCounter = 0

		if Farm_MeleeUpgrades then
			UpgradeStructurePlayerEvent:FireServer("Melee", "KillMoney")
			UpgradeStructurePlayerEvent:FireServer("Melee", "AttackSpeed")
			UpgradeStructurePlayerEvent:FireServer("Melee", "Damage")
			UpgradeStructurePlayerEvent:FireServer("Melee", "Lifesteal")
			UpgradeStructurePlayerEvent:FireServer("Melee", "WitherDamage")
		end
	end
end

local function Run_Combat_InfiniteAmmoResell()
	local currentGun = GetCurrentGun()
	if not currentGun then
		RemoveOldReticle()
	end
	
	if isReselling then
		return
	end

	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local humanoid = localCharacter:FindFirstChildWhichIsA("Humanoid")
	if not humanoid then
		return
	end

	local foundTool = localCharacter:FindFirstChildWhichIsA("Tool")
	if not foundTool then
		return
	end

	if foundTool.Name ~= "Pistol" then
		local bargainerPerk = PlayerPerks:FindFirstChild("SellValue")
		if not bargainerPerk then
			return
		end

		if bargainerPerk.PerkLevel.Value < 4 then
			return
		end
	end

	local currentValues = foundTool:FindFirstChild("CurrentValues")
	if not currentValues then
		return
	end

	local clipValue = currentValues:FindFirstChild("Clip")
	if not clipValue then
		return
	end

	if clipValue.Value > 0 then
		return
	end

	if isReselling then
		return
	end
	isReselling = true

	local toolName = foundTool.Name

	SellWeaponEvent:FireServer(toolName)
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()

	BuyWeaponEvent:FireServer(toolName)
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()

	isReselling = false
end

local function UpdateBulletSpread(tool)
	local currentValues = tool:FindFirstChild("CurrentValues")
	local defaultValues = tool:FindFirstChild("DefaultValues")

	if not (currentValues and defaultValues) then
		return
	end	

	local isGun = defaultValues:FindFirstChild("Spread")
	if not isGun then
		return
	end

	local multipler = Combat_ChangeSpread / 100

	local success = pcall(function()
		currentValues.Spread.Value = defaultValues.Spread.Value * multipler
		currentValues.SpreadDecrease.Value = defaultValues.SpreadDecrease.Value * multipler
		currentValues.SpreadIncrease.Value = defaultValues.SpreadIncrease.Value * multipler
		currentValues.SpreadMax.Value = defaultValues.SpreadMax.Value * multipler

		currentValues.ZoomSpread.Value = defaultValues.ZoomSpread.Value * multipler
		currentValues.ZoomSpreadDecrease.Value = defaultValues.ZoomSpreadDecrease.Value * multipler
		currentValues.ZoomSpreadIncrease.Value = defaultValues.ZoomSpreadIncrease.Value * multipler
		currentValues.ZoomSpreadMax.Value = defaultValues.ZoomSpreadMax.Value * multipler
	end)
end

local function Run_Combat_BulletSpread()
	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	for _, tool in Backpack:GetChildren() do
		UpdateBulletSpread(tool)
	end

	for _, tool in localCharacter:GetChildren() do
		if not tool:IsA("Tool") then
			continue
		end

		UpdateBulletSpread(tool)
	end

	for _, tool in ToolStorage:GetChildren() do
		UpdateBulletSpread(tool)
	end
end

