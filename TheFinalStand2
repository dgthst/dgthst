local function GetClosestZombie(usePriority)
	if not ZombiesFolder then
		return
	end

	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local bestModel = nil
	local bestHead = nil
	local bestPriority = nil
	local bestDistance = nil

	local function IsWithinShootRange(rootPart, currentValues)
		local rangeValue = currentValues:FindFirstChild("Range")
		if not rangeValue then
			return false
		end

		local magnitude = (rootPart.Position - localRoot.Position).Magnitude

		local forgivenRange = 10
		if magnitude > rangeValue.Value - forgivenRange then
			return false
		end

		return true
	end

	local function ValidateZombie(model)
		local humanoid = model:FindFirstChild("Zombie")
		if not humanoid then
			return
		end

		if humanoid.Health <= 0 then
			return
		end

		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end

		local head = model:FindFirstChild("Head")
		if not head then
			return
		end

		local currentGun, currentValues = GetCurrentGun()
		if currentGun then
			if not IsWithinShootRange(rootPart, currentValues) then
				return false
			end
		else
			return false
		end

		return true, rootPart, head
	end

	local function GetZombiePriority(model)
		if model.Name == "Hunter" and Combat_PriorityHunter then
			return 2
		elseif model.Name == "Boss" and Combat_PriorityBoss then
			return 1
		else
			return 0
		end
	end

	for _, model in ZombiesFolder:GetChildren() do
		local valid, rootPart, head = ValidateZombie(model)
		if not valid then
			continue
		end

		if model:FindFirstChildWhichIsA("ForceField") then
			continue
		end

		local magnitude = (rootPart.Position - localRoot.Position).Magnitude
		local priority = usePriority and GetZombiePriority(model) or 0

		if bestModel == nil
			or priority > bestPriority
			or (priority == bestPriority and magnitude < bestDistance)
		then
			bestModel = model
			bestHead = head
			bestPriority = priority
			bestDistance = magnitude
		end
	end

	return bestModel, bestHead
end

local function UpdateESPHighlights()
	local objectsFolder = CoreGui:FindFirstChild("RuntimeObjects")
	if not objectsFolder then
		return
	end

	local zombieSubFolder = objectsFolder:FindFirstChild("Zombie")
	if not zombieSubFolder then
		return
	end

	for _, categoryFolder in zombieSubFolder:GetChildren() do
		for _, highlight in categoryFolder:GetChildren() do
			if highlight:IsA("Highlight") then
				if ESP_IgnoreNonSpecial then
					highlight.Enabled = ESP_Zombie and categoryFolder.Name == "Special"
				else
					highlight.Enabled = ESP_Zombie
				end
			end
		end
	end

	local playerFolder = objectsFolder:FindFirstChild("Player")
	if not playerFolder then
		return
	end

	for _, highlight in playerFolder:GetChildren() do
		if highlight:IsA("Highlight") then
			highlight.Enabled = ESP_Player
		end
	end
end

local function ConvertKeybindToEnum(keybind: string)
	local input = keybind:lower()

	local userInputTypeMap = {
		mousebutton1 = Enum.UserInputType.MouseButton1,
		mousebutton2 = Enum.UserInputType.MouseButton2,
		mousebutton3 = Enum.UserInputType.MouseButton3,
		touch = Enum.UserInputType.Touch,
		keyboard = Enum.UserInputType.Keyboard,
		gamepad1 = Enum.UserInputType.Gamepad1,
		gamepad2 = Enum.UserInputType.Gamepad2,
		gamepad3 = Enum.UserInputType.Gamepad3,
		gamepad4 = Enum.UserInputType.Gamepad4,
		gamepad5 = Enum.UserInputType.Gamepad5,
		gamepad6 = Enum.UserInputType.Gamepad6,
		gamepad7 = Enum.UserInputType.Gamepad7,
		gamepad8 = Enum.UserInputType.Gamepad8,
	}

	if userInputTypeMap[input] then
		return userInputTypeMap[input]
	end

	for _, keyCode in Enum.KeyCode:GetEnumItems() do
		if keyCode.Name:lower() == input then
			return keyCode
		end
	end

	return nil
end

local function ConvertWeaponNameToActualName(name)
	local inputName = name:lower():gsub("%s+", "")

	for _, tool in ToolStorage:GetChildren() do
		local toolName = tool.Name:lower():gsub("%s+", "")

		if toolName == inputName then
			return tool.Name
		end
	end

	return nil
end

