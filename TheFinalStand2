local function GetLocalCharacter()
	local localCharacter = LocalPlayer.Character
	if not localCharacter then
		return
	end

	local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
	if not localRoot then
		return
	end

	return localCharacter, localRoot
end

local function GetClosestZombie(usePriority)
	if not ZombiesFolder then
		return
	end

	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local closestModel = nil
	local shortestDistance = nil

	local function ValidateZombie(model)
		local humanoid = model:FindFirstChild("Zombie")
		if not humanoid then
			return
		end

		if humanoid.Health <= 0 then
			return
		end

		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			return
		end

		local head = model:FindFirstChild("Head")
		if not head then
			return
		end
		
		return true, rootPart
	end
	
	local function ShouldPreferZombie(model)
		if not usePriority then
			return
		end
		
		if Combat_PriorityBoss then
			if model.Name == "Boss" then
				return true
			end
		end
	end

	for _, model in ZombiesFolder:GetChildren() do
		local valid, rootPart = ValidateZombie(model)
		if not valid then
			continue
		end
		
		if ShouldPreferZombie(model) then
			closestModel = model
			break
		end
		
		local magnitude = (rootPart.Position - localRoot.Position).Magnitude

		if shortestDistance and magnitude > shortestDistance then
			continue
		end

		closestModel = model
		shortestDistance = magnitude
	end

	return closestModel, if closestModel then closestModel:FindFirstChild("Head") else nil
end

