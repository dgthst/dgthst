local function UpdateBulletSpread(tool)
	local currentValues = tool:FindFirstChild("CurrentValues")
	local defaultValues = tool:FindFirstChild("DefaultValues")

	if not (currentValues and defaultValues) then
		return
	end	

	local isGun = defaultValues:FindFirstChild("Spread")
	if not isGun then
		return
	end

	local multipler = Combat_ChangeSpread / 100

	local success = pcall(function()
		currentValues.Spread.Value = defaultValues.Spread.Value * multipler
		currentValues.SpreadDecrease.Value = defaultValues.SpreadDecrease.Value * multipler
		currentValues.SpreadIncrease.Value = defaultValues.SpreadIncrease.Value * multipler
		currentValues.SpreadMax.Value = defaultValues.SpreadMax.Value * multipler

		currentValues.ZoomSpread.Value = defaultValues.ZoomSpread.Value * multipler
		currentValues.ZoomSpreadDecrease.Value = defaultValues.ZoomSpreadDecrease.Value * multipler
		currentValues.ZoomSpreadIncrease.Value = defaultValues.ZoomSpreadIncrease.Value * multipler
		currentValues.ZoomSpreadMax.Value = defaultValues.ZoomSpreadMax.Value * multipler
	end)
end

local function Run_Combat_BulletSpread()
	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local backpack = GetLocalBackpack()

	for _, tool in backpack:GetChildren() do
