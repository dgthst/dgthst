local function Run_Aimbot_AimAssist()
	lockedOnZombie = false

	if not isAiming and not Combat_AutoLock then
		return
	end

	if not PlayerIsFirstPerson() then
		return
	end

	local zombieModel, zombieHead = GetClosestZombie(true)
	if not zombieModel then
		return
	end

	local targetPosition = zombieHead.Position

	if zombieHead.Transparency == 1 then
		local rootPart = zombieModel:FindFirstChild("HumanoidRootPart")
		if rootPart then
			targetPosition = rootPart.Position
		end
	end

	CurrentCamera.CFrame = CFrame.new(CurrentCamera.CFrame.Position, targetPosition)

	lockedOnZombie = true
end

local function AutoMovement_Spawn(localCharacter, localRoot, humanoid)
	if not localCharacter:GetAttribute("Roblox") then
		SetCameraHorizontal(SpawnExit.Position)

		local calculation = (SpawnExit.Position - localRoot.Position)
		if calculation.Magnitude > 3 then
			humanoid:Move(calculation.Unit)
			return true
		end

		localCharacter:SetAttribute("Roblox", true)

		PlayerTeleportEvent:FireServer(localRoot.Position, 1)
		localCharacter:TranslateBy(Vector3.new(0, 0.2, 12))
	end
end

