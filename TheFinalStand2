-- [Helper] --

local function GetLocalCharacter()
	local localCharacter = LocalPlayer.Character
	if not localCharacter then
		return
	end

	local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
	if not localRoot then
		return
	end

	return localCharacter, localRoot
end

local function GetClosestZombie()
	local localCharacter, localRoot = GetLocalCharacter()
	if not localCharacter then
		return
	end

	local closestModel = nil
	local shortestDistance = nil

	for _, model in workspace.Zombies:GetChildren() do
		local humanoid = model:FindFirstChild("Zombie")
		if not humanoid then
			continue
		end

		if humanoid.Health <= 0 then
			continue
		end

		local rootPart = model:FindFirstChild("HumanoidRootPart")
		if not rootPart then
			continue
		end

		local head = model:FindFirstChild("Head")
		if not head then
			continue
		end

		local magnitude = (rootPart.Position - localRoot.Position).Magnitude

		if shortestDistance and magnitude > shortestDistance then
			continue
		end

		closestModel = model
		shortestDistance = magnitude
	end

	return closestModel, if closestModel then closestModel:FindFirstChild("Head") else nil
end

local function UpdateESPHighlights()
