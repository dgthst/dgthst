local function ConvertKeybindToEnum(keybind: string)
	local input = keybind:lower()

	local userInputTypeMap = {
		mousebutton1 = Enum.UserInputType.MouseButton1,
		mousebutton2 = Enum.UserInputType.MouseButton2,
		mousebutton3 = Enum.UserInputType.MouseButton3,
		touch = Enum.UserInputType.Touch,
		keyboard = Enum.UserInputType.Keyboard,
		gamepad1 = Enum.UserInputType.Gamepad1,
		gamepad2 = Enum.UserInputType.Gamepad2,
		gamepad3 = Enum.UserInputType.Gamepad3,
		gamepad4 = Enum.UserInputType.Gamepad4,
		gamepad5 = Enum.UserInputType.Gamepad5,
		gamepad6 = Enum.UserInputType.Gamepad6,
		gamepad7 = Enum.UserInputType.Gamepad7,
		gamepad8 = Enum.UserInputType.Gamepad8,
	}

	if userInputTypeMap[input] then
		return userInputTypeMap[input]
	end

	for _, keyCode in Enum.KeyCode:GetEnumItems() do
		if keyCode.Name:lower() == input then
			return keyCode
		end
	end

	return nil
end

local function ConvertWeaponNameToActualName(name)
	local inputName = name:lower():gsub("%s+", "")

	for _, tool in ToolStorage:GetChildren() do
		local toolName = tool.Name:lower():gsub("%s+", "")

		if toolName == inputName then
			return tool.Name
		end
	end

	return nil
end

