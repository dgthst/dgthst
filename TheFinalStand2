local function GetDefaultFOV()
    local current = PlayerGui
    local path = {
        "MenuGui",
        "SettingsFrame",
        "Settings",
        "OptionsFrame",
        "FieldOfView",
        "Margins",
        "Amount"
    }

    for _, name in ipairs(path) do
        current = current:FindFirstChild(name)
        if not current then
            return
        end
    end

    return tonumber(current.Text)
end

local function IsPlayerAiming()
	local currentFOV = CurrentCamera.FieldOfView
	local defaultFOV = GetDefaultFOV()

	if not defaultFOV then
		return
	end

	if currentFOV < defaultFOV then
		return true
	end

	return false
end

local function PlayerIsAlive()
	local localHumanoid = GetLocalHumanoid()
